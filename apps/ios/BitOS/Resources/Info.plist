<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleDisplayName</key>
    <string>BitOS</string>
    <key>UILaunchScreen</key>
    <dict>
        <key>UIColorName</key>
        <string>SplashBackground</string>
        <key>UIImageName</key>
        <string>SplashLogo</string>
    </dict>
    <key>NSCameraUsageDescription</key>
    <string>BitOS uses the camera only when you choose to record a Bitz or MEM.</string>
    <key>NSMicrophoneUsageDescription</key>
    <string>BitOS uses the microphone only when you record audio, voice-over, or video.</string>
    <key>NSPhotoLibraryUsageDescription</key>
    <string>BitOS reads media you select for a project.</string>
    <key>NSPhotoLibraryAddUsageDescription</key>
    <string>BitOS saves an export only when you ask it to.</string>
    <key>UISupportedInterfaceOrientations</key>
    <array>
        <string>UIInterfaceOrientationPortrait</string>
    </array>
    <!-- T16 deep links (spec §1.2): nostr: entities + lightning: invoices. -->
    <key>CFBundleURLTypes</key>
    <array>
        <dict>
            <key>CFBundleURLName</key>
            <string>space.bitos.app.nostr</string>
            <key>CFBundleURLSchemes</key>
            <array>
                <string>nostr</string>
            </array>
        </dict>
        <dict>
            <key>CFBundleURLName</key>
            <string>space.bitos.app.lightning</string>
            <key>CFBundleURLSchemes</key>
            <array>
                <string>lightning</string>
            </array>
        </dict>
    </array>
</dict>
</plist>
