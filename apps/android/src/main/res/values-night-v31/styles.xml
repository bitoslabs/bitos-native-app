<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ system splash, dark mode: @color/splash_background
         resolves through values-night to the brand-dark floor under the
         white wordmark branding strip (drawable-night bitos_branding). -->
    <style name="Theme.BitOS.Launch">
        <item name="android:windowSplashScreenBackground">@color/splash_background</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@color/splash_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/bitos_splash_mark</item>
        <item name="android:windowSplashScreenBrandingImage">@drawable/bitos_splash_branding</item>
    </style>
</resources>
