<?xml version="1.0" encoding="utf-8"?>
<!-- Raw BitOS lightning bolt (official SVG: 664×297 viewport, yellow→
     Bitcoin-orange gradient). Unlike bitos_splash_mark.xml (which is
     pre-scaled/translated for the Android 12 circle mask), this vector is
     the untransformed mark — the in-app boot screen scales it into the hex
     avatar, mirroring assets/icons/bitos-lightning-bolt.svg in the legacy
     Flutter app. -->
