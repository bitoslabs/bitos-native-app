    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="664dp"
    android:height="297dp"
    android:viewportWidth="664"
    android:viewportHeight="297">
    <path android:fillType="evenOdd"
        android:pathData="M 0,296 C 37,254 69,222 99,195 C 135,163 168,139 199,121 L 313,51 C 317,49 320,52 318,57 L 306,119 C 370,81 429,55 484,36 C 547,14 606,3 664,0 C 619,14 580,29 548,45 C 508,65 472,83 441,99 C 397,122 354,149 312,180 L 231,243 C 227,246 228,241 229,236 L 241,160 C 195,184 148,211 101,241 C 65,264 31,282 0,296 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="0"
                android:startY="0"
                android:endX="664"
                android:endY="297"
                android:type="linear">
                <item
                    android:color="#FFFFD83D"
                    android:offset="0.0" />
                <item
                    android:color="#FFFFB51B"
                    android:offset="0.5" />
                <item
                    android:color="#FFF7931A"
                    android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
